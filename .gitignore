# --- build output ---
dist/
docs/.vitepress/dist/
docs/.vitepress/cache/
# Precompressed siblings written by `npm run compress`. The ones under dist/
# and docs/ are already covered above; these are the /public originals, whose
# sources ARE tracked.
public/**/*.br
public/**/*.gz

# --- dependencies ---
node_modules/

# --- runtime state: settings, ACME keys and certificates, logs ---
data/
*.log

# --- local configuration and secrets ---
.env
.env.local
# The list of hosts to deploy to is per-operator; hosts.example is tracked.
deploy/hosts

# --- editors and OS ---
.DS_Store
*.swp
.idea/
.vscode/*
!.vscode/settings.json
