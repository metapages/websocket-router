{
  "name": "websocket-router",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "A public address space for realtime messages. Single process, no broker.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/server/index.js",
  "scripts": {
    "build": "npm run build:server && npm run build:web && npm run compress",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "vite build",
    "compress": "node scripts/precompress.mjs",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/server/index.js",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "acme-client": "^5.4.0",
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "pino": "^10.4.0",
    "pino-roll": "^4.0.0",
    "qrcode": "^1.5.4",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@metapages/hash-query": "^0.4.7",
    "@metapages/metapage": "^0.15.0",
    "@types/compression": "^1.8.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.5.13",
    "reconnecting-websocket": "^4.4.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "undici": "^7.30.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
