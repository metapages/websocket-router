# Local development. Copy to .env — every value here has a working default,
# so an empty file works too.
#
# Production configuration lives in /opt/websocket-router/env on the host,
# written by deploy/bootstrap.sh. See docs/reference/configuration.md.

PORT=3077
APP_FQDN=localhost:3077
LOG_LEVEL=debug

# Enables the panel at /admin. Unset means it does not exist (404), which is
# the right default for anything exposed.
ADMIN_PASSWORD=dev

# TLS is off locally: certificates need a public DNS name and port 80.
TLS_ENABLED=false

# Serves the connection inspector at /<INSPECT_KEY>: what is connected, for
# how long, and (by subscribing) what it is sending. The path is the whole
# credential, so unset means the route does not exist. At least 16 characters
# of [A-Za-z0-9_-]; generate one with `openssl rand -hex 16`.
INSPECT_KEY=local-inspector-key-0000
